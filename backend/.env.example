# ── Instance parameters (multi-instance / Phase A) ───────────────────────────
# Municipalities dataset validated on public signup. 'sp' maps to
# src/data/municipios_sp_645.csv; any other value <name> loads
# src/data/municipios_<name>.csv (same CSV layout: header + "code,name" rows).
# GEO_DATASET="sp"
# State code stamped on municipalities created by the app.
# GEO_STATE_CODE="SP"
# Set to "false" on instances that do not collect the "igreja" field on
# supporter registration (region-based verticals). Supporters are then linked
# to the sentinel church record "(sem igreja)".
# CHURCH_FIELD_ENABLED="true"

# ── Multi-tenant (Fase B) ────────────────────────────────────────────────────
# Slug do tenant desta instância. Cada processo do backend atende UM tenant e
# todas as queries ficam escopadas a ele; várias instâncias podem compartilhar
# o mesmo DATABASE_URL. O default 'default' é o tenant criado pela migração
# para adotar os dados pré-existentes — instâncias que já rodavam não precisam
# definir nada. Para um tenant novo: bun run create:tenant -- --slug <slug>
# --name "<Nome>" e suba a instância com TENANT_SLUG=<slug>.
# Ver MULTITENANCY.md na raiz do repositório.
# TENANT_SLUG="default"

# ── WhatsApp / UazapiGO (9 variáveis) ───────────────────────────────────────
# URL base da API UazapiGO v2.1.1, sem barra final.
UAZAPI_BASE_URL="https://uazapi.exemplo.com"
# Token administrativo: usado somente para criar a instância.
UAZAPI_ADMIN_TOKEN=""
# Segredo aleatório recebido pelo webhook público. Ex.: openssl rand -hex 32
UAZAPI_WEBHOOK_SECRET=""
# Chave exclusiva para cifrar o token da instância: 64 hex ou base64 de 32 bytes.
# Ex.: openssl rand -hex 32
WHATSAPP_ENCRYPTION_KEY=""
# URL HTTPS pública da API deste deploy, incluindo /api quando o proxy o utiliza.
PUBLIC_API_URL="https://redeguti.ddnsfree.com/api"
# Intervalo de atraso, em segundos, enviado ao UazapiGO para cada lote.
WHATSAPP_DELAY_MIN=5
WHATSAPP_DELAY_MAX=15
# Limite de upload local em MiB e teto de destinatários válidos por campanha.
WHATSAPP_UPLOAD_MAX_MB=20
WHATSAPP_MASS_MAX_RECIPIENTS=1000
