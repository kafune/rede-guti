// Prisma schema for Rede Evangelica SP

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  COORDENADOR
  LIDER_REGIONAL
  VERIFICADORA
}

enum IndicationStatus {
  ATIVO
  INATIVO
}

enum WhatsAppCampaignStatus {
  DRAFT
  SCHEDULED
  QUEUED
  SENDING
  PAUSED
  COMPLETED
  CANCELING
  CANCELED
  FAILED
}

enum WhatsAppRecipientStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  READ
  PLAYED
  FAILED
  CANCELED
}

enum WhatsAppRecipientOrigin {
  INDICATION
  EVENT_GUEST
  TEAM_DRIVER
  TEAM_MEMBER
  MANUAL
}

enum WhatsAppCampaignCategory {
  MARKETING
  UTILITY
}

enum WhatsAppInteractionStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

// Fase B multi-tenant: cada instância (vertical) é um tenant. Todas as tabelas
// de dados carregam tenant_id NOT NULL; o processo do backend resolve o tenant
// pelo TENANT_SLUG no boot e a extensão do Prisma Client (src/db.ts) injeta o
// escopo em todas as queries. O tenant 'default' (id fixo) adota os dados
// pré-existentes na migração.
model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  users                User[]
  churches             Church[]
  municipalities       Municipality[]
  indications          Indication[]
  eventos              Evento[]
  eventoIndicados      EventoIndicado[]
  atividades           Atividade[]
  leaderStats          LeaderStats[]
  pointsLedger         LeaderPointsLedger[]
  metasCidade          MetaCidade[]
  equipes              Equipe[]
  equipeMembros        EquipeMembro[]
  equipeVisitas        EquipeVisita[]
  membroCadastros      MembroCadastro[]
  membroCadastroDocs   MembroCadastroDocumento[]
  igrejas              IgrejaCadastro[]
  equipeIgrejas        EquipeIgreja[]
  appConfig            AppConfig?
  whatsappConfig       WhatsAppConfig?
  whatsappCampaigns    WhatsAppCampaign[]
  whatsappRecipients   WhatsAppRecipient[]
  whatsappTemplates    WhatsAppTemplate[]
  whatsappMedia        WhatsAppMedia[]
  whatsappSuppressions WhatsAppSuppression[]
  whatsappInteractions WhatsAppInteraction[]
  electoralZones        ElectoralZone[]
  bairroZonas           BairroZona[]
  teams                 Team[]
  teamMembers           TeamMember[]
  teamChurchAssignments TeamChurchAssignment[]
  visits                Visit[]
  visitCheckins         VisitCheckin[]
  auditLogs             AuditLog[]
  territorySettings     TerritorySettings?
  geocodeCache          GeocodeCache[]

  @@map("tenants")
}

model User {
  id                          String                @id @default(cuid())
  tenantId                    String                @map("tenant_id")
  email                       String
  name                        String?               @map("name")
  devzappLink                 String?               @map("devzapp_link")
  passwordHash                String                @map("password_hash")
  role                        Role                  @default(LIDER_REGIONAL)
  // Conta desativada não faz login nem usa a API (checado em plugins/auth.ts).
  active                      Boolean               @default(true)
  indicatedByUserId           String?               @map("indicated_by_user_id")
  createdAt                   DateTime              @default(now()) @map("created_at")
  tenant                      Tenant                @relation(fields: [tenantId], references: [id])
  indicatedByUser             User?                 @relation("UserIndications", fields: [indicatedByUserId], references: [id], onDelete: SetNull)
  indicatedUsers              User[]                @relation("UserIndications")
  createdIndications          Indication[]          @relation("CreatedBy")
  indicatedSupporters         Indication[]          @relation("IndicatedByUser")
  eventoIndicacoes            EventoIndicado[]      @relation("LiderEventoIndicados")
  atividades                  Atividade[]           @relation("LiderAtividades")
  equipes                     Equipe[]              @relation("LiderEquipes")
  igrejasCadastradas          IgrejaCadastro[]      @relation("IgrejaCriadaPor")
  leaderStats                 LeaderStats?
  pointsLedger                LeaderPointsLedger[]
  teamsLed                    Team[]                @relation("TeamLeader")
  teamsDriving                Team[]                @relation("TeamDriver")
  teamMemberships            TeamMember[]
  visitsDriving              Visit[]               @relation("VisitDriver")
  authoredWhatsAppCampaigns   WhatsAppCampaign[]    @relation("WhatsAppCampaignAuthor")
  authoredWhatsAppTemplates   WhatsAppTemplate[]    @relation("WhatsAppTemplateAuthor")
  uploadedWhatsAppMedia       WhatsAppMedia[]       @relation("WhatsAppMediaUploader")
  createdWhatsAppSuppressions WhatsAppSuppression[] @relation("WhatsAppSuppressionCreatedBy")
  whatsappReauthorizations    WhatsAppSuppression[] @relation("WhatsAppSuppressionReauthorizedBy")

  @@unique([tenantId, email])
  @@index([role])
  @@index([indicatedByUserId])
  @@index([tenantId])
  @@map("users")
}

model LeaderStats {
  id                 String    @id @default(cuid())
  userId             String    @unique @map("user_id")
  totalIndications   Int       @default(0) @map("total_indications")
  weeklyIndications  Int       @default(0) @map("weekly_indications")
  monthlyIndications Int       @default(0) @map("monthly_indications")
  totalConfirmed     Int       @default(0) @map("total_confirmed")
  totalPresent       Int       @default(0) @map("total_present")
  score              Float     @default(0) @map("score")
  rankingPosition    Int?      @map("ranking_position")
  lastActivityAt     DateTime? @map("last_activity_at")
  currentStreak      Int       @default(0) @map("current_streak")
  tenantId           String    @map("tenant_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([score])
  @@index([rankingPosition])
  @@index([tenantId])
  @@map("leader_stats")
}

model LeaderPointsLedger {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  eventType String   @map("event_type")
  points    Int
  metadata  Json?
  tenantId  String   @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@index([tenantId])
  @@map("leader_points_ledger")
}

// Uma linha por tenant (deixou de ser singleton na Fase B).
model AppConfig {
  id                 String   @id @default(cuid())
  tenantId           String   @unique @map("tenant_id")
  whatsappGroupLink  String?  @map("whatsapp_group_link")
  announcement       String?  @map("announcement")
  // Chave geral: bloqueia temporariamente o acesso de todas as lideranças
  // (LIDER_REGIONAL) sem desativá-las individualmente.
  liderAccessBlocked Boolean  @default(false) @map("lider_access_blocked")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("app_config")
}

model Church {
  id          String       @id @default(cuid())
  tenantId    String       @map("tenant_id")
  name        String
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  // ── Cadastro territorial (opcional; preenchido no módulo de Igrejas) ────────
  // Campos nulos por padrão: o registro-sentinela e igrejas herdadas do fluxo
  // de apoiadores continuam válidos sem nenhum destes preenchidos.
  denomination     String?
  pastorName       String? @map("pastor_name")
  phone            String?
  whatsapp         String?
  email            String?

  street           String?
  number           String?
  complement       String?
  district         String? // bairro — chave da resolução de zona eleitoral
  city             String?
  state            String?
  postalCode       String? @map("postal_code")
  formattedAddress String? @map("formatted_address")

  latitude            Float?
  longitude           Float?
  geocodingProvider   String? @map("geocoding_provider")
  geocodingConfidence String? @map("geocoding_confidence")

  // Associação à Zona Eleitoral + metadados de auditoria da classificação.
  electoralZoneId          String?   @map("electoral_zone_id")
  zoneClassificationMethod String?   @map("zone_classification_method")
  zoneConfidenceScore      Float?    @map("zone_confidence_score")
  zoneSource               String?   @map("zone_source")
  zoneRequiresReview       Boolean   @default(false) @map("zone_requires_review")
  zoneValidatedById        String?   @map("zone_validated_by_id")
  zoneValidatedAt          DateTime? @map("zone_validated_at")

  currentTeamId String? @map("current_team_id")

  status             String  @default("ativa")
  priority           String?
  verificationStatus String  @default("nao_verificada") @map("verification_status")
  notes              String?

  tenant        Tenant                 @relation(fields: [tenantId], references: [id])
  indications   Indication[]
  electoralZone ElectoralZone?         @relation(fields: [electoralZoneId], references: [id], onDelete: SetNull)
  currentTeam   Team?                  @relation("ChurchCurrentTeam", fields: [currentTeamId], references: [id], onDelete: SetNull)
  visits        Visit[]
  assignments   TeamChurchAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([electoralZoneId])
  @@index([currentTeamId])
  @@index([district])
  @@map("churches")
}

// ── Módulo Territorial (Igrejas × Zona Eleitoral × Equipes × Visitas) ─────────

// Zona Eleitoral (unidade territorial de trabalho). Guarulhos: 176, 185, 278,
// 279, 393, 394, 395. Semeada a partir do "Mapa Político de Guarulhos".
model ElectoralZone {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  number    String // "176", "185", ...
  name      String?
  color     String?
  eleitores Int?
  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  churches Church[]
  teams    Team[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@map("electoral_zones")
}

// Dicionário bairro → zona (fonte "Nível A/B" do prompt). Um bairro pode mapear
// para mais de uma zona (sobreposições no mapa) — nesse caso a resolução marca
// a igreja como "requer validação".
model BairroZona {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  bairroNormalized String   @map("bairro_normalized")
  bairroLabel      String   @map("bairro_label")
  zoneNumber       String   @map("zone_number")
  source           String   @default("Mapa Político de Guarulhos")
  createdAt        DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, bairroNormalized, zoneNumber])
  @@index([tenantId, bairroNormalized])
  @@map("bairro_zonas")
}

model Team {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  name            String
  electoralZoneId String?  @map("electoral_zone_id")
  leaderUserId    String?  @map("leader_user_id")
  driverUserId    String?  @map("driver_user_id")
  vehicle         String?
  status          String   @default("ativa")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant        Tenant                 @relation(fields: [tenantId], references: [id])
  electoralZone ElectoralZone?         @relation(fields: [electoralZoneId], references: [id], onDelete: SetNull)
  leader        User?                  @relation("TeamLeader", fields: [leaderUserId], references: [id], onDelete: SetNull)
  driver        User?                  @relation("TeamDriver", fields: [driverUserId], references: [id], onDelete: SetNull)
  members       TeamMember[]
  churches      Church[]               @relation("ChurchCurrentTeam")
  assignments   TeamChurchAssignment[]
  visits        Visit[]

  @@index([tenantId])
  @@index([electoralZoneId])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  teamId    String   @map("team_id")
  userId    String   @map("user_id")
  role      String?
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([tenantId])
  @@map("team_members")
}

// Histórico de atribuições igreja → equipe (o ponteiro "equipe atual" fica em
// Church.currentTeamId; esta tabela é o log auditável de quem atribuiu quando).
model TeamChurchAssignment {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  teamId       String   @map("team_id")
  churchId     String   @map("church_id")
  assignedById String?  @map("assigned_by_id")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([churchId])
  @@index([teamId])
  @@map("team_church_assignments")
}

// Visita programada. Cada igreja tem, por padrão, 2 visitas (visit_number 1 e 2).
// Entidade própria (não colunas na igreja) para manter histórico e reagendamento.
model Visit {
  id           String @id @default(cuid())
  tenantId     String @map("tenant_id")
  churchId     String @map("church_id")
  teamId       String? @map("team_id")
  driverUserId String? @map("driver_user_id")
  visitNumber  Int     @map("visit_number")

  scheduledDate      DateTime? @map("scheduled_date")
  scheduledStartTime String?   @map("scheduled_start_time")
  scheduledEndTime   String?   @map("scheduled_end_time")

  status String @default("aguardando_agendamento")

  // Link individual da visita (token aleatório, não sequencial, revogável).
  publicToken  String  @unique @map("public_token")
  tokenRevoked Boolean @default(false) @map("token_revoked")

  // Check-in "autoritativo" (último válido) — o histórico completo fica em
  // VisitCheckin (append-only). Facilita as queries de listagem/dashboard.
  checkinAt              DateTime? @map("checkin_at")
  checkinLatitude        Float?    @map("checkin_latitude")
  checkinLongitude       Float?    @map("checkin_longitude")
  checkinAccuracy        Float?    @map("checkin_accuracy")
  checkinDeviceTimestamp DateTime? @map("checkin_device_timestamp")
  distanceFromChurch     Float?    @map("distance_from_church")
  geofenceStatus         String?   @map("geofence_status")
  justification          String?

  checkoutAt DateTime? @map("checkout_at")

  // Prestação de contas (resultado da visita).
  outcome              String?
  outcomeHappened      String?   @map("outcome_happened")
  responsibleContacted String?   @map("responsible_contacted")
  nextAction           String?   @map("next_action")
  followUpDate         DateTime? @map("follow_up_date")
  notes                String?

  // Foto comprobatória (MVP: data URL base64 no banco; upgrade → object storage).
  // O original nunca é alterado; o "carimbo" é sobreposto na UI a partir dos
  // metadados de check-in (não bakeia um segundo arquivo).
  photoUrl        String?   @map("photo_url")
  photoHash       String?   @map("photo_hash")
  photoUploadedAt DateTime? @map("photo_uploaded_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  church   Church         @relation(fields: [churchId], references: [id], onDelete: Cascade)
  team     Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  driver   User?          @relation("VisitDriver", fields: [driverUserId], references: [id], onDelete: SetNull)
  checkins VisitCheckin[]

  @@unique([churchId, visitNumber])
  @@index([tenantId])
  @@index([churchId])
  @@index([teamId])
  @@index([status])
  @@index([scheduledDate])
  @@map("visits")
}

// Append-only: uma linha por tentativa de check-in. O check-in original nunca é
// sobrescrito silenciosamente (requisito do prompt).
model VisitCheckin {
  id                 String    @id @default(cuid())
  tenantId           String    @map("tenant_id")
  visitId            String    @map("visit_id")
  latitude           Float?
  longitude          Float?
  accuracy           Float?
  deviceTimestamp    DateTime? @map("device_timestamp")
  serverTimestamp    DateTime  @default(now()) @map("server_timestamp")
  distanceFromChurch Float?    @map("distance_from_church")
  geofenceStatus     String?   @map("geofence_status")
  withinGeofence     Boolean?  @map("within_geofence")
  justification      String?
  photoUrl           String?   @map("photo_url")
  photoHash          String?   @map("photo_hash")
  createdAt          DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  visit  Visit  @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([visitId])
  @@map("visit_checkins")
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Configurações operacionais do módulo territorial (uma linha por tenant).
model TerritorySettings {
  id                  String   @id @default(cuid())
  tenantId            String   @unique @map("tenant_id")
  checkinRadiusMeters Int      @default(100) @map("checkin_radius_meters")
  checkinWarnMeters   Int      @default(200) @map("checkin_warn_meters")
  requirePhoto        Boolean  @default(true) @map("require_photo")
  visitsPerChurch     Int      @default(2) @map("visits_per_church")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("territory_settings")
}

// Cache de geocodificação: evita reconsultar o mesmo endereço no provedor
// (Nominatim tem limite de ~1 req/s). Guarda também negativos (found=false).
model GeocodeCache {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  addressKey       String   @map("address_key")
  latitude         Float?
  longitude        Float?
  provider         String?
  confidence       String?
  formattedAddress String?  @map("formatted_address")
  found            Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, addressKey])
  @@index([tenantId])
  @@map("geocode_cache")
}

model Municipality {
  id          String       @id @default(cuid())
  tenantId    String       @map("tenant_id")
  name        String
  stateCode   String       @default("SP") @map("state_code")
  createdAt   DateTime     @default(now()) @map("created_at")
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  indications Indication[]
  metas       MetaCidade[]

  @@unique([tenantId, name, stateCode])
  @@index([tenantId])
  @@map("municipalities")
}

enum EventoIndicadoStatus {
  INDICADO
  APROVADO
  RECUSADO
  CONFIRMADO
  PRESENTE
}

model Evento {
  id             String           @id @default(cuid())
  tenantId       String           @map("tenant_id")
  nome           String
  data           DateTime
  hora           String
  local          String
  limitePorLider Int              @default(0) @map("limite_por_lider")
  observacao     String?
  encerrado      Boolean          @default(false)
  createdAt      DateTime         @default(now()) @map("created_at")
  tenant         Tenant           @relation(fields: [tenantId], references: [id])
  indicados      EventoIndicado[]

  @@index([tenantId])
  @@map("eventos")
}

model EventoIndicado {
  id        String               @id @default(cuid())
  tenantId  String               @map("tenant_id")
  eventoId  String               @map("evento_id")
  nome      String
  telefone  String
  liderId   String               @map("lider_id")
  status    EventoIndicadoStatus @default(INDICADO)
  createdAt DateTime             @default(now()) @map("created_at")
  tenant    Tenant               @relation(fields: [tenantId], references: [id])
  evento    Evento               @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  lider     User                 @relation("LiderEventoIndicados", fields: [liderId], references: [id])

  @@unique([eventoId, telefone])
  @@index([eventoId])
  @@index([liderId])
  @@index([tenantId])
  @@map("evento_indicados")
}

model Atividade {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  liderId       String   @map("lider_id")
  titulo        String
  descricao     String?
  dataHora      DateTime @map("data_hora")
  local         String?
  qtdEnvolvidos Int      @default(0) @map("qtd_envolvidos")
  createdAt     DateTime @default(now()) @map("created_at")
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  lider         User     @relation("LiderAtividades", fields: [liderId], references: [id])

  @@index([liderId])
  @@index([dataHora])
  @@index([tenantId])
  @@map("atividades")
}

model Indication {
  id                String           @id @default(cuid())
  tenantId          String           @map("tenant_id")
  name              String
  phone             String?
  email             String?
  status            IndicationStatus @default(ATIVO)
  indicatedBy       String?          @map("indicated_by")
  indicatedByUserId String?          @map("indicated_by_user_id")
  createdAt         DateTime         @default(now()) @map("created_at")
  createdById       String           @map("created_by_id")
  churchId          String           @map("church_id")
  municipalityId    String           @map("municipality_id")

  tenant          Tenant       @relation(fields: [tenantId], references: [id])
  createdBy       User         @relation("CreatedBy", fields: [createdById], references: [id])
  indicatedByUser User?        @relation("IndicatedByUser", fields: [indicatedByUserId], references: [id], onDelete: SetNull)
  church          Church       @relation(fields: [churchId], references: [id])
  municipality    Municipality @relation(fields: [municipalityId], references: [id])

  @@index([createdAt])
  @@index([createdById])
  @@index([churchId])
  @@index([municipalityId])
  @@index([indicatedByUserId])
  @@index([tenantId])
  @@map("indications")
}

// Planejamento eleitoral por cidade (metas de votos da coordenação).
// Uma linha por município: dados de referência (eleitores, votos válidos) e a
// meta digitável. O percentual buscado é calculado no app (meta / votos válidos)
// e o acompanhamento real cruza com os apoiadores cadastrados no município.
model MetaCidade {
  id             String       @id @default(cuid())
  tenantId       String       @map("tenant_id")
  municipalityId String       @unique @map("municipality_id")
  regiao         String?
  eleitores      Int          @default(0)
  votosValidos   Int          @default(0) @map("votos_validos")
  meta           Int          @default(0)
  observacao     String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  municipality   Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("metas_cidade")
}

enum EquipeStatus {
  ATIVA
  INATIVA
}

// Equipe de campanha (porta de igreja): 1 motorista com carro próprio + até 4
// apoiadores. Pertence a uma liderança (liderId). valor/valorObservacoes são o
// custo combinado com a coordenação — visíveis e editáveis SOMENTE pelo
// COORDENADOR (a rota faz strip para os demais papéis).
model Equipe {
  id                     String         @id @default(cuid())
  tenantId               String         @map("tenant_id")
  liderId                String         @map("lider_id")
  nome                   String
  motoristaNome          String         @map("motorista_nome")
  motoristaCnh           String         @map("motorista_cnh")
  motoristaTelefone      String         @map("motorista_telefone")
  motoristaTituloEleitor String?        @map("motorista_titulo_eleitor")
  motoristaSecao         String?        @map("motorista_secao")
  carroPlaca             String         @map("carro_placa")
  carroModelo            String         @map("carro_modelo")
  carroCor               String         @map("carro_cor")
  status                 EquipeStatus   @default(ATIVA)
  // Origem do cadastro: MANUAL (dentro do app) ou AUTOCADASTRO (link público).
  origem                 String         @default("MANUAL")
  valor                  Decimal?       @db.Decimal(12, 2)
  valorObservacoes       String?        @map("valor_observacoes")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")
  tenant                 Tenant         @relation(fields: [tenantId], references: [id])
  lider                  User           @relation("LiderEquipes", fields: [liderId], references: [id])
  membros                EquipeMembro[]
  visitas                EquipeVisita[]
  igrejas                EquipeIgreja[]
  cadastros              MembroCadastro[]

  @@index([liderId])
  @@index([tenantId])
  @@map("equipes")
}

model EquipeMembro {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  equipeId      String   @map("equipe_id")
  nome          String
  telefone      String
  tituloEleitor String?  @map("titulo_eleitor")
  secao         String?  @map("secao")
  ordem         Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  equipe        Equipe   @relation(fields: [equipeId], references: [id], onDelete: Cascade)

  @@index([equipeId])
  @@index([tenantId])
  @@map("equipe_membros")
}

// Prestação de contas: cada visita ("porta de igreja") registrada por uma equipe
// em campo, normalmente pelo link público da própria equipe. Guarda local,
// data/hora, foto de comprovação, observação e geolocalização opcional.
model EquipeVisita {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  equipeId     String   @map("equipe_id")
  local        String
  dataHora     DateTime @map("data_hora")
  observacoes  String?
  fotoUrl      String?  @map("foto_url")
  latitude     Float?
  longitude    Float?
  // Nome livre de quem registrou (o link público não exige login).
  registradoPor String? @map("registrado_por")
  createdAt    DateTime @default(now()) @map("created_at")
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  equipe       Equipe   @relation(fields: [equipeId], references: [id], onDelete: Cascade)

  @@index([equipeId])
  @@index([tenantId])
  @@map("equipe_visitas")
}

// Autocadastro individual de cada pessoa da equipe (motorista ou apoiador),
// preenchido pela própria pessoa por um link público (sem login). Guarda os
// dados pessoais, o aceite do trabalho e as fotos de documentos anexadas.
//
// Identidade por "slot" estável, e não pelo id do EquipeMembro: a edição da
// equipe recria os membros (deleteMany + create), o que trocaria os ids. Assim,
// o motorista é sempre pessoaTipo=MOTORISTA (slot nulo) e cada apoiador é
// pessoaTipo=APOIADOR + slot = ordem (0..3). Os dados enviados ficam guardados
// aqui, então mesmo que a equipe seja reeditada nada se perde.
model MembroCadastro {
  id              String                     @id @default(cuid())
  tenantId        String                     @map("tenant_id")
  equipeId        String                     @map("equipe_id")
  // 'MOTORISTA' | 'APOIADOR'
  pessoaTipo      String                     @map("pessoa_tipo")
  // Posição do apoiador (ordem 0..3); nulo para o motorista.
  slot            Int?
  // Referência informativa ao membro no momento do envio (não é a chave: pode
  // ficar defasada após uma reedição da equipe).
  membroId        String?                    @map("membro_id")
  nomeCompleto    String                     @map("nome_completo")
  cpf             String?
  rg              String?
  dataNascimento  String?                    @map("data_nascimento")
  telefone        String?
  email           String?
  cep             String?
  endereco        String?
  bairro          String?
  cidade          String?
  observacoes     String?
  consentimento   Boolean                    @default(false)
  consentimentoEm DateTime?                  @map("consentimento_em")
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")
  tenant          Tenant                     @relation(fields: [tenantId], references: [id])
  equipe          Equipe                     @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  documentos      MembroCadastroDocumento[]

  @@index([equipeId])
  @@index([tenantId])
  @@index([membroId])
  @@map("membro_cadastros")
}

// Foto de documento anexada a um autocadastro (RG/CNH, comprovante etc.).
// Guardada como data URL base64 (mesma abordagem das fotos de visita),
// redimensionada no cliente antes do envio.
model MembroCadastroDocumento {
  id         String         @id @default(cuid())
  tenantId   String         @map("tenant_id")
  cadastroId String         @map("cadastro_id")
  // Rótulo livre: "RG (frente)", "CNH", "Comprovante de residência"...
  tipo       String         @default("Documento")
  imagemUrl  String         @map("imagem_url")
  createdAt  DateTime       @default(now()) @map("created_at")
  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  cadastro   MembroCadastro @relation(fields: [cadastroId], references: [id], onDelete: Cascade)

  @@index([cadastroId])
  @@index([tenantId])
  @@map("membro_cadastro_documentos")
}

// Cadastro de igrejas (módulo independente). Registro rico com dados de
// localização e eleitorais. origem: 'admin' (cadastro logado), 'public'
// (autocadastro por link de equipe) ou 'import'. Não substitui o catálogo
// simples `Church` usado pelas indicações — coexistem.
model IgrejaCadastro {
  id               String         @id @default(cuid())
  tenantId         String         @map("tenant_id")
  nome             String
  denominacao      String         @default("")
  pastor           String         @default("")
  endereco         String         @default("")
  bairro           String         @default("")
  cidade           String         @default("Guarulhos")
  estado           String         @default("SP")
  telefone         String         @default("")
  email            String         @default("")
  latitude         Float?
  longitude        Float?
  observacoes      String         @default("")
  membrosEstimados Int?           @map("membros_estimados")
  zonaEleitoral    Int?           @map("zona_eleitoral")
  origem           String         @default("admin")
  // Rótulo livre da liderança de origem (ex.: importação em massa quando não há
  // usuário correspondente). Preserva o vínculo declarado no cadastro.
  liderancaLabel   String?        @map("lideranca_label")
  createdById      String?        @map("created_by")
  createdAt        DateTime       @default(now()) @map("created_at")
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  createdBy        User?          @relation("IgrejaCriadaPor", fields: [createdById], references: [id], onDelete: SetNull)
  equipes          EquipeIgreja[]

  @@index([tenantId])
  @@index([createdById])
  @@map("igrejas")
}

// Vínculo igreja <-> equipe (team_church_assignments no spec original). Usado no
// autocadastro por link: toda igreja cadastrada pelo link da equipe fica atribuída.
model EquipeIgreja {
  id            String         @id @default(cuid())
  tenantId      String         @map("tenant_id")
  equipeId      String         @map("equipe_id")
  igrejaId      String         @map("igreja_id")
  dataAgendada  DateTime?      @map("data_agendada") @db.Date
  assignedAt    DateTime       @default(now()) @map("assigned_at")
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  equipe        Equipe         @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  igreja        IgrejaCadastro @relation(fields: [igrejaId], references: [id], onDelete: Cascade)

  @@index([equipeId])
  @@index([igrejaId])
  @@index([tenantId])
  @@map("equipe_igrejas")
}

model WhatsAppConfig {
  id                     String    @id @default(cuid())
  tenantId               String    @unique @map("tenant_id")
  instanceId             String?   @map("instance_id")
  instanceName           String?   @map("instance_name")
  instanceTokenEncrypted String?   @map("instance_token_encrypted")
  phone                  String?
  status                 String?
  webhookConfiguredAt    DateTime? @map("webhook_configured_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("whatsapp_configs")
}

model WhatsAppCampaign {
  id                    String                   @id @default(cuid())
  tenantId              String                   @map("tenant_id")
  createdById           String                   @map("created_by_id")
  name                  String
  status                WhatsAppCampaignStatus   @default(DRAFT)
  category              WhatsAppCampaignCategory
  audienceFilter        Json                     @map("audience_filter")
  content               Json
  consentAt             DateTime                 @map("consent_at")
  scheduledAt           DateTime?                @map("scheduled_at")
  remoteFolderId        String?                  @map("remote_folder_id")
  remoteFolderStatus    String?                  @map("remote_folder_status")
  remoteFolderCreatedAt DateTime?                @map("remote_folder_created_at")
  idempotencyKey        String?                  @map("idempotency_key")
  retryOfCampaignId     String?                  @map("retry_of_campaign_id")
  totalRecipients       Int                      @default(0) @map("total_recipients")
  validRecipients       Int                      @default(0) @map("valid_recipients")
  excludedRecipients    Int                      @default(0) @map("excluded_recipients")
  queuedCount           Int                      @default(0) @map("queued_count")
  sentCount             Int                      @default(0) @map("sent_count")
  failedCount           Int                      @default(0) @map("failed_count")
  deliveredCount        Int                      @default(0) @map("delivered_count")
  readCount             Int                      @default(0) @map("read_count")
  playedCount           Int                      @default(0) @map("played_count")
  replyCount            Int                      @default(0) @map("reply_count")
  optOutCount           Int                      @default(0) @map("opt_out_count")
  lastError             String?                  @map("last_error")
  queuedAt              DateTime?                @map("queued_at")
  startedAt             DateTime?                @map("started_at")
  pausedAt              DateTime?                @map("paused_at")
  completedAt           DateTime?                @map("completed_at")
  canceledAt            DateTime?                @map("canceled_at")
  failedAt              DateTime?                @map("failed_at")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")

  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  createdBy    User                  @relation("WhatsAppCampaignAuthor", fields: [createdById], references: [id])
  recipients   WhatsAppRecipient[]
  interactions WhatsAppInteraction[]
  retryOf      WhatsAppCampaign?     @relation("WhatsAppCampaignRetries", fields: [retryOfCampaignId], references: [id], onDelete: SetNull)
  retries      WhatsAppCampaign[]    @relation("WhatsAppCampaignRetries")

  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, retryOfCampaignId])
  @@index([tenantId, status])
  @@index([createdById])
  @@index([scheduledAt])
  @@map("whatsapp_campaigns")
}

model WhatsAppRecipient {
  id                       String                  @id @default(cuid())
  tenantId                 String                  @map("tenant_id")
  campaignId               String                  @map("campaign_id")
  origin                   WhatsAppRecipientOrigin
  sourceId                 String?                 @map("source_id")
  sourceName               String?                 @map("source_name")
  personName               String                  @map("person_name")
  phoneOriginal            String                  @map("phone_original")
  phoneNormalized          String?                 @map("phone_normalized")
  personalizedContent      Json                    @map("personalized_content")
  isValid                  Boolean                 @default(true) @map("is_valid")
  exclusionReason          String?                 @map("exclusion_reason")
  status                   WhatsAppRecipientStatus @default(PENDING)
  externalMessageIds       String[]                @default([]) @map("external_message_ids")
  processedWebhookEventIds String[]                @default([]) @map("processed_webhook_event_ids")
  externalChatId           String?                 @map("external_chat_id")
  error                    String?
  queuedAt                 DateTime?               @map("queued_at")
  sentAt                   DateTime?               @map("sent_at")
  deliveredAt              DateTime?               @map("delivered_at")
  readAt                   DateTime?               @map("read_at")
  playedAt                 DateTime?               @map("played_at")
  failedAt                 DateTime?               @map("failed_at")
  canceledAt               DateTime?               @map("canceled_at")
  createdAt                DateTime                @default(now()) @map("created_at")
  updatedAt                DateTime                @updatedAt @map("updated_at")

  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  campaign     WhatsAppCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  interactions WhatsAppInteraction[]

  @@index([tenantId, phoneNormalized])
  @@index([campaignId, status])
  @@map("whatsapp_recipients")
}

model WhatsAppTemplate {
  id          String                   @id @default(cuid())
  tenantId    String                   @map("tenant_id")
  createdById String                   @map("created_by_id")
  name        String
  category    WhatsAppCampaignCategory
  purpose     String?
  content     Json
  favorite    Boolean                  @default(false)
  version     Int                      @default(1)
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  createdBy User   @relation("WhatsAppTemplateAuthor", fields: [createdById], references: [id])

  @@unique([tenantId, name])
  @@index([createdById])
  @@map("whatsapp_templates")
}

model WhatsAppMedia {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  uploadedById String   @map("uploaded_by_id")
  filename     String
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  bytes        Bytes
  publicToken  String   @unique @map("public_token")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  uploadedBy User   @relation("WhatsAppMediaUploader", fields: [uploadedById], references: [id])

  @@index([tenantId, createdAt])
  @@index([uploadedById])
  @@map("whatsapp_media")
}

model WhatsAppSuppression {
  id               String    @id @default(cuid())
  tenantId         String    @map("tenant_id")
  phoneNormalized  String    @map("phone_normalized")
  active           Boolean   @default(true)
  reason           String?
  source           String?
  createdById      String?   @map("created_by_id")
  firstOptOutAt    DateTime  @default(now()) @map("first_opt_out_at")
  lastOptOutAt     DateTime  @default(now()) @map("last_opt_out_at")
  reauthorizedAt   DateTime? @map("reauthorized_at")
  reauthorizedById String?   @map("reauthorized_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant         Tenant @relation(fields: [tenantId], references: [id])
  createdBy      User?  @relation("WhatsAppSuppressionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reauthorizedBy User?  @relation("WhatsAppSuppressionReauthorizedBy", fields: [reauthorizedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, phoneNormalized])
  @@index([tenantId, active])
  @@index([createdById])
  @@index([reauthorizedById])
  @@map("whatsapp_suppressions")
}

model WhatsAppInteraction {
  id              String                    @id @default(cuid())
  tenantId        String                    @map("tenant_id")
  campaignId      String?                   @map("campaign_id")
  recipientId     String?                   @map("recipient_id")
  externalId      String                    @map("external_id")
  eventType       String                    @map("event_type")
  direction       String
  status          WhatsAppInteractionStatus @default(RECEIVED)
  phoneNormalized String?                   @map("phone_normalized")
  payload         Json
  occurredAt      DateTime                  @map("occurred_at")
  processedAt     DateTime?                 @map("processed_at")
  error           String?
  createdAt       DateTime                  @default(now()) @map("created_at")

  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  campaign  WhatsAppCampaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  recipient WhatsAppRecipient? @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([tenantId, externalId])
  @@index([campaignId])
  @@index([recipientId])
  @@index([tenantId, occurredAt])
  @@map("whatsapp_interactions")
}
